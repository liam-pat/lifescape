---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleMeta from '../components/ArticleMeta.astro';
import ImageModal from '../components/ImageModal.astro';
import LivePhotoRenderer from '../components/LivePhotoRenderer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import type { PostEntry } from '../lib/content';
import Layout from './Layout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	entry: PostEntry;
	headings: Heading[];
}

const { entry, headings } = Astro.props;
const isReading = entry.collection === 'reading';
const readingEntry = isReading ? entry as CollectionEntry<'reading'> : null;
const allEntries = isReading
	? await getCollection('reading')
	: await getCollection('life');
const latestEntries = allEntries
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 10);
const seriesEntries = latestEntries.some((item) => item.id === entry.id)
	? latestEntries
	: [entry, ...latestEntries];
const seriesPath = isReading ? 'reading' : 'life';
const seriesTitle = isReading ? 'Latest Readings' : 'Latest Lifes';
const tagClass = isReading
	? 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100'
	: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100';

const tocItems = headings.filter(({ depth }) => depth >= 1 && depth <= 4);
const tocIndent = (depth: number) => `toc-depth-${depth}`;
---

<Layout title={entry.data.title}>
	<main class="max-w-screen-2xl mx-auto px-4 py-8">
		<div class="lg:flex lg:gap-2">
			{tocItems.length > 0 && (
				<aside class="hidden lg:block w-48 shrink-0">
					<div class="sticky top-24">
						<p class="toc-title">TOC</p>
						<nav aria-label="Table of contents">
							<ul class="toc-list space-y-2 text-sm text-right">
								{tocItems.map((heading) => (
									<li>
										<a
											href={`#${heading.slug}`}
											class={`toc-link ${tocIndent(heading.depth)}`}
											data-toc-link
										>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</div>
				</aside>
			)}

			<div class="flex-1">
				<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm">
						<article data-pagefind-body class="prose prose-sm md:prose lg:prose-xl dark:prose-invert mx-auto p-4 md:p-8">
						<header class="mb-6 md:mb-8">
							<h1 class="text-2xl md:text-4xl font-bold mb-3 md:mb-4 dark:text-white">
								{entry.data.title}
							</h1>
							{readingEntry ? (
								<div class="flex flex-col gap-2 text-gray-600 dark:text-gray-400 text-sm md:text-base">
									<div class="flex flex-wrap items-center gap-2 md:gap-4">
										<ArticleMeta entry={entry} tagClass={tagClass} />
									</div>
									<div class="grid gap-y-1">
										<div class="flex items-baseline gap-x-2">
											<span class="font-medium whitespace-nowrap">书名</span>
											<span class="mx-1 text-gray-400">:</span>
											<span>{readingEntry.data.book.title}</span>
										</div>
										<div class="flex items-baseline gap-x-2">
											<span class="font-medium whitespace-nowrap">作者</span>
											<span class="mx-1 text-gray-400">:</span>
											<span>{readingEntry.data.book.author}</span>
										</div>
										{readingEntry.data.book.rating && (
											<div class="flex items-baseline gap-x-2">
												<span class="font-medium whitespace-nowrap">评分</span>
												<span class="mx-1 text-gray-400">:</span>
												<span>{readingEntry.data.book.rating}/5</span>
											</div>
										)}
									</div>
								</div>
							) : (
								<div class="flex flex-wrap items-center gap-2 md:gap-4 text-gray-600 dark:text-gray-400 text-sm md:text-base">
									<ArticleMeta entry={entry} tagClass={tagClass} />
								</div>
							)}
						</header>

						<div class="mt-6 md:mt-8">
							<slot />
						</div>
					</article>
				</div>
			</div>

			{seriesEntries.length > 0 && (
				<aside class="hidden lg:block w-48 shrink-0">
					<div class="sticky top-24">
						<p class="series-title">{seriesTitle}</p>
						<nav aria-label="Series">
							<ul class="series-list space-y-2 text-sm text-left">
								{seriesEntries.map((seriesEntry) => (
									<li>
										<a
												href={`/${seriesPath}/${seriesEntry.id}/`}
											class={`series-link${seriesEntry.id === entry.id ? ' is-active' : ''}`}
										>
											{seriesEntry.data.title}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</div>
				</aside>
			)}
		</div>
	</main>

	<ReadingProgress />
	<LivePhotoRenderer />
	<ImageModal />
</Layout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
		if (tocLinks.length === 0) return;

		const tocMap = new Map(
			tocLinks.map((link) => [link.getAttribute('href')?.slice(1), link])
		);
		const headings = Array.from(document.querySelectorAll('article h1, article h2, article h3, article h4'))
			.filter((heading) => heading.id && tocMap.has(heading.id));
		if (headings.length === 0) return;

		let activeId = null;
		const setActive = (id) => {
			if (!id || id === activeId) return;
			activeId = id;
			tocLinks.forEach((link) => {
				const isActive = link.getAttribute('href') === `#${id}`;
				link.classList.toggle('is-active', isActive);
				if (isActive) {
					link.setAttribute('aria-current', 'true');
				} else {
					link.removeAttribute('aria-current');
				}
			});
		};

		const onScroll = () => {
			const offset = 120;
			let currentId = headings[0]?.id;
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top - offset <= 0) {
					currentId = heading.id;
				} else {
					break;
				}
			}
			setActive(currentId);
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		onScroll();
	});
</script>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	.toc-list { border-right: 1px solid #e5e7eb; }
	.series-list { border-left: 1px solid #e5e7eb; }

	.toc-title,
	.series-title {
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #9ca3af;
		margin-bottom: 0.75rem;
	}

	.toc-title { text-align: right; }

	.toc-link,
	.series-link {
		display: block;
		position: relative;
		color: #6b7280;
		opacity: 0.12;
		filter: blur(1px);
		transition: opacity 180ms ease, filter 180ms ease, color 180ms ease;
	}

	.toc-link { margin-right: -1px; }

	.series-link {
		padding-left: 1.25rem;
		margin-left: -1px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.toc-depth-1 { padding-right: 0.75rem; font-size: 1.05rem; letter-spacing: 0.01em; }
	.toc-depth-2 { padding-right: 1.25rem; font-size: 1rem; }
	.toc-depth-3 { padding-right: 2rem; font-size: 0.85rem; }
	.toc-depth-4 { padding-right: 2.75rem; font-size: 0.75rem; }

	.toc-link:hover,
	.series-link:hover { color: #1f2937; }

	.toc-link::before,
	.series-link::before {
		content: '';
		position: absolute;
		top: 0.6em;
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: #2563eb;
		opacity: 0;
		transform: scale(0.8);
		transition: opacity 150ms ease, transform 150ms ease;
	}

	.toc-link::before { right: -5px; }
	.series-link::before { left: -5px; }

	.toc-link.is-active,
	.series-link.is-active {
		color: #111827;
		font-weight: 600;
		opacity: 1;
		filter: none;
	}

	.toc-link.is-active::before,
	.series-link.is-active::before {
		opacity: 1;
		transform: scale(1);
	}

	.toc-list:hover .toc-link,
	.toc-list:focus-within .toc-link,
	.series-list:hover .series-link,
	.series-list:focus-within .series-link {
		opacity: 1;
		filter: none;
	}

	:global(.dark) .toc-list { border-right-color: #374151; }
	:global(.dark) .series-list { border-left-color: #374151; }
	:global(.dark) :is(.toc-title, .series-title) { color: #cbd5e1; }

	:global(.dark) :is(.toc-link, .series-link) {
		color: #f1f5f9;
		opacity: 0.22;
	}

	:global(.dark) :is(.toc-link, .series-link):hover { color: #f3f4f6; }

	:global(.dark) :is(.toc-link, .series-link).is-active {
		color: #f9fafb;
		opacity: 1;
		filter: none;
	}

	:global(.dark) :is(.toc-link, .series-link)::before { background: #60a5fa; }

	.prose :global(img) {
		margin: 1.5rem auto;
		border-radius: 0.7rem;
		width: 800px;
		max-width: 90%;
		height: auto;
		display: block;
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -1px rgb(0 0 0 / 6%);
		cursor: zoom-in;
		transition: transform 0.3s ease;
		object-fit: contain;
	}

	.prose :global(img:hover) { transform: scale(1.02); }

	.prose :global(img:is([alt*='landscape'], [alt*='横屏'])) {
		width: 950px;
		max-width: 95%;
	}

	.prose :global(img:is([alt*='portrait'], [alt*='竖屏'])) {
		width: 520px;
		max-width: 80%;
		max-height: 70vh;
	}

	.prose :global(img:is([alt*='square'], [alt*='正方'])) {
		width: 650px;
		max-width: 85%;
		max-height: 65vh;
	}

	.prose :global(img + img) { margin-top: 1.5rem; }
	.prose :global(p:has(img):has(+ p:has(img))) { margin-bottom: 0.5rem; }

	.prose :global(img + em) {
		display: block;
		text-align: center;
		font-size: 0.875rem;
		color: #6b7280;
		margin-top: 0.5rem;
		margin-bottom: 1.5rem;
	}

	:global(.dark) .prose :global(img + em) { color: #9ca3af; }
	:global(.dark) .prose :global(pre) { background-color: #1e293b !important; }
	:global(.dark) .prose :global(code) { color: #e2e8f0 !important; }

	@media (max-width: 1024px) {
		.prose :global(img) { width: 650px; max-width: 95%; }
		.prose :global(img:is([alt*='landscape'], [alt*='横屏'])) { width: 750px; }
		.prose :global(img:is([alt*='portrait'], [alt*='竖屏'])) { width: 450px; max-width: 85%; }
		.prose :global(img:is([alt*='square'], [alt*='正方'])) { width: 600px; max-width: 90%; }
	}

	@media (max-width: 768px) {
		.prose :global(img) { width: 100%; max-width: 100%; margin: 1rem auto; }
		.prose :global(img:is([alt*='landscape'], [alt*='横屏'])) { width: 100%; max-width: 100%; }
		.prose :global(img:is([alt*='portrait'], [alt*='竖屏'])) { width: 80%; max-width: 80%; max-height: 60vh; }
		.prose :global(img:is([alt*='square'], [alt*='正方'])) { width: 90%; max-width: 90%; max-height: 50vh; }
		.prose :global(h1) { font-size: 1.5rem !important; margin: 0.5em 0 !important; }
		.prose :global(h2) { font-size: 1.25rem !important; margin: 0.5em 0 0.3em !important; }
		.prose :global(h3) { font-size: 1.125rem !important; margin: 0.5em 0 0.3em !important; }

		.prose :global(p) {
			font-size: 0.875rem !important;
			margin: 0.3em 0 !important;
			line-height: 1.5 !important;
		}

		.prose :global(ul),
		.prose :global(ol) { padding-left: 1rem !important; margin: 0.3em 0 !important; }
		.prose :global(li) { font-size: 0.875rem !important; margin: 0.2em 0 !important; }

		.prose :global(blockquote),
		.prose :global(pre) {
			padding: 0.5rem !important;
			margin: 0.5em 0 !important;
			font-size: 0.875rem !important;
		}

		.prose :global(code) { font-size: 0.875rem !important; }
	}
</style>
