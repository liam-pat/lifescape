---
import SearchPopup from '../components/SearchPopup.astro';
import {
	getAlternateLocale,
	localeLanguageTags,
	localizePath,
	ui,
	type Locale,
} from '../lib/i18n';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	locale?: Locale;
	alternatePath?: string;
}

const {
	title,
	locale = 'zh',
	description = ui[locale].siteDescription,
	alternatePath,
} = Astro.props;
const copy = ui[locale];
const alternateLocale = getAlternateLocale(locale);
const currentYear = new Date().getFullYear();
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const alternateUrl = alternatePath ? new URL(alternatePath, siteBase) : null;
const xDefaultUrl = locale === 'zh' ? canonicalUrl : alternateUrl;
const homePath = localizePath(locale, '/');
const lifePath = localizePath(locale, '/life/');
const readingPath = localizePath(locale, '/reading/');
const technologyPath = localizePath(locale, '/technology/');
const aboutPath = localizePath(locale, '/about/');
const rssPath = localizePath(locale, '/rss.xml');
---

<!DOCTYPE html>
<html lang={localeLanguageTags[locale]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description}>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="https://gz-blog-storage-1252787757.cos.ap-guangzhou.myqcloud.com/public/life/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={localeLanguageTags[locale]} href={canonicalUrl} />
		{alternateUrl && (
			<link rel="alternate" hreflang={localeLanguageTags[alternateLocale]} href={alternateUrl} />
		)}
		{xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
		<link rel="alternate" type="application/rss+xml" title="RSS Feed" href={rssPath} />
		<!-- LXGW WenKai Screen font -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/lxgwwenkaiscreenr.css" />
		<title>{title}</title>
		<script is:inline>
			// Use light mode by default.
			if (!('theme' in localStorage)) {
				localStorage.theme = 'light';
				document.documentElement.classList.remove('dark');
			} else if (localStorage.theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			</script>
		<style is:global>
			/* Always reserve scrollbar gutter to prevent layout shift during animations */
			html {
				scrollbar-gutter: stable;
			}

			/* Typewriter effect */
			.typewriter {
				display: block;
				max-width: 100%;
				line-height: 1.5;
				min-height: 3em; /* Keep the layout stable. */
				position: relative;
			}

			.typewriter-text {
				display: inline;
				position: relative;
				margin: 0;
				white-space: pre-wrap;
				overflow-wrap: break-word;
				visibility: hidden; /* Hide text at first. */
			}

			.typewriter-text.typing {
				visibility: visible; /* Show text while typing. */
			}

			.typewriter-cursor {
				display: inline-block;
				width: 2px;
				height: 1em;
				background-color: currentColor;
				margin-left: 1px;
				vertical-align: text-bottom;
				animation: blink-caret 0.75s step-end infinite;
			}
			
			.typewriter-cursor.hide {
				display: none; /* Hide the cursor. */
			}

			@keyframes blink-caret {
				from, to { opacity: 0; }
				50% { opacity: 1; }
			}

			@media (max-width: 768px) {
				.typewriter {
					min-height: 6em; /* Reserve space on mobile. */
				}
				
				.typewriter-text {
					width: 100%;
					font-size: 0.9em; /* Fit longer mobile text. */
				}
			}
		</style>
	</head>
	<body class="flex min-h-screen flex-col bg-[#E8E8E8] font-wenkai dark:bg-night-bg">
		<nav class="bg-white dark:bg-night-surface shadow-sm dark:border-b dark:border-night-border">
			<div class="max-w-7xl mx-auto px-4">
				<div class="flex justify-between h-14">
					<div class="flex items-center">
						<a href={homePath} class="text-lg font-semibold text-gray-800 dark:text-night-text">
							version.me
						</a>
					</div>

					{/* Desktop navigation */}
					<div class="hidden md:flex md:items-center md:space-x-6">
						<a href={lifePath} class="text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text">
							Life
						</a>
						<a href={readingPath} class="text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text">
							Reading
						</a>
						<a href={technologyPath} class="text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text">
							Technology
						</a>
						<a href={aboutPath} class="text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text">
							ME
						</a>
						<a href="https://weekly.biyongyao.com" target="_blank" class="text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text">
							Weekly
						</a>
						<a href={rssPath} class="flex items-center text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text" title="RSS Feed">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
								<path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
								<path d="M4 9a1 1 0 000 2c3.314 0 6 2.686 6 6a1 1 0 102 0c0-4.418-3.582-8-8-8z" />
								<circle cx="3.5" cy="16.5" r="1.5" />
							</svg>
							<span class="ml-1">RSS</span>
						</a>
						<!-- Search button -->
						<button id="search-button" class="flex items-center text-sm text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text" title={copy.search.buttonLabel}>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
							</svg>
							<span class="ml-1">Search</span>
						</button>
					</div>

					{/* Mobile menu button */}
					<div class="flex items-center md:hidden">
						<!-- Mobile search button -->
						<button id="search-button-mobile" class="p-2 mr-2 text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:text-night-text" title={copy.search.buttonLabel}>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
							</svg>
						</button>
						<button type="button" class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-100 focus:outline-none" aria-expanded="false" aria-label={copy.mobileMenuLabel}>
							<svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>

				{/* Mobile menu */}
				<div class="mobile-menu hidden md:hidden">
					<div class="pt-2 pb-3 space-y-1">
						<a href={lifePath} class="block px-3 py-2 text-base text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-50 rounded-md">
							Life
						</a>
						<a href={readingPath} class="block px-3 py-2 text-base text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-50 rounded-md">
							Reading
						</a>
						<a href={technologyPath} class="block px-3 py-2 text-base text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-50 rounded-md">
							Technology
						</a>
						<a href={aboutPath} class="block px-3 py-2 text-base text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-50 rounded-md">
							ME
						</a>
						<a href={rssPath} class="flex items-center px-3 py-2 text-base text-gray-600 hover:text-gray-800 dark:text-night-muted dark:hover:bg-night-elevated dark:hover:text-night-text hover:bg-gray-50 rounded-md">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
								<path d="M4 9a1 1 0 000 2c3.314 0 6 2.686 6 6a1 1 0 102 0c0-4.418-3.582-8-8-8z" />
								<circle cx="3.5" cy="16.5" r="1.5" />
							</svg>
							<span class="ml-2">RSS</span>
						</a>
					</div>
				</div>
			</div>
		</nav>

		<div class="flex-1">
			<slot />
		</div>

		<footer class="bg-white dark:bg-night-surface dark:border-t dark:border-night-border mt-12 py-6">
			<div class="max-w-7xl mx-auto px-4 text-center text-sm text-gray-600 dark:text-night-muted">
					<p>&copy; {currentYear} VERSION.ME</p>
			</div>
		</footer>

		{/* Language button */}
		{alternatePath && (
			<a
				href={alternatePath}
				class="fixed bottom-6 left-6 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-sm font-bold tracking-wide text-gray-800 shadow-lg transition-shadow hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:border dark:border-night-border dark:bg-night-elevated dark:text-night-text dark:shadow-black/40"
				lang={localeLanguageTags[alternateLocale]}
				aria-label={copy.switchLanguage}
			>
				{ui[alternateLocale].languageShortName}
			</a>
		)}

		<!-- Theme button -->
		<button id="theme-toggle" class="fixed bottom-6 right-6 p-2 bg-white dark:border dark:border-night-border dark:bg-night-elevated rounded-full shadow-lg dark:shadow-black/40 hover:shadow-xl transition-shadow" aria-label={copy.themeToggleLabel}>
			<!-- Light mode icon -->
			<svg class="w-6 h-6 text-gray-800 dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
			</svg>
			<!-- Dark mode icon -->
			<svg class="hidden w-6 h-6 text-night-text dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
			</svg>
		</button>

		<!-- Search popup -->
		<SearchPopup locale={locale} />

		<script is:inline>
			// Toggle the mobile menu.
			document.addEventListener('DOMContentLoaded', () => {
				const button = document.querySelector('.mobile-menu-button');
				const menu = document.querySelector('.mobile-menu');

				// Run the typewriter effect.
				const typewriterTexts = document.querySelectorAll('.typewriter-text');
				typewriterTexts.forEach(text => {
					const fullText = text.textContent || '';
					let currentText = '';
					let index = 0;
					
					// Create the cursor.
					const cursor = document.createElement('span');
					cursor.className = 'typewriter-cursor';
					
					// Replace the source text.
					text.textContent = '';
					text.parentNode.insertBefore(cursor, text.nextSibling);
					
					// Start after a short delay.
					setTimeout(() => {
						// Show the text.
						text.classList.add('typing');
						
						// Type one character at a time.
						const typingInterval = setInterval(() => {
							if (index < fullText.length) {
								currentText += fullText.charAt(index);
								text.textContent = currentText;
								index++;
							} else {
								clearInterval(typingInterval);
								
								// Hide the cursor after typing.
								setTimeout(() => {
									cursor.classList.add('hide');
								}, 2000);
							}
						}, 100); // Fixed typing speed.
					}, 500);
				});

				button?.addEventListener('click', () => {
					menu?.classList.toggle('hidden');
					const expanded = button.getAttribute('aria-expanded') === 'true';
					button.setAttribute('aria-expanded', (!expanded).toString());
				});

				// Set up theme switching.
				const themeToggle = document.getElementById('theme-toggle');
				
				// Toggle the theme.
				themeToggle?.addEventListener('click', () => {
					if (document.documentElement.classList.contains('dark')) {
						document.documentElement.classList.remove('dark');
						localStorage.theme = 'light';
					} else {
						document.documentElement.classList.add('dark');
						localStorage.theme = 'dark';
					}
				});

				// Set up search.
				const searchButton = document.getElementById('search-button');
				const searchButtonMobile = document.getElementById('search-button-mobile');
				
				// Open search from the desktop button.
				searchButton?.addEventListener('click', () => {
					if (typeof window.openSearchPopup === 'function') {
						window.openSearchPopup();
					}
				});
				
				// Open search from the mobile button.
				searchButtonMobile?.addEventListener('click', () => {
					if (typeof window.openSearchPopup === 'function') {
						window.openSearchPopup();
					}
				});
			});
		</script>
	</body>
</html>
