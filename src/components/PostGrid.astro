---
import PostCard from './PostCard.astro';
import type { PostEntry } from '../lib/content';

interface Props {
	entries: PostEntry[];
	showCollectionPrefix?: boolean;
}

const { entries, showCollectionPrefix = false } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
	{entries.map((entry) => (
		<PostCard entry={entry} showCollectionPrefix={showCollectionPrefix} />
	))}
</div>
