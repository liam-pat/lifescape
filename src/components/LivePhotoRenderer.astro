<style is:global>
  /* Keep the original image layout. */
  .live-photo-container {
    position: relative;
    display: block; /* Center the container. */
    width: 800px;
    max-width: 90%;
    margin: 1.5rem auto; /* Match prose images. */
    border-radius: 0.7rem; /* Match prose images. */
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    cursor: zoom-in;
    background-color: #000; /* Hide empty corners. */
  }

  /* Fill table cells. */
  td .live-photo-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }

  /* Avoid duplicate spacing and shadows. */
  .prose .live-photo-container img {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 0 auto !important;
    border-radius: 0 !important; /* Use the container radius. */
    box-shadow: none !important;
    cursor: zoom-in;
    transition: opacity 0.4s ease;
  }

  /* Keep mixed table images aligned. */
  .prose table img {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  /* Place the video over the image. */
  .live-photo-container .live-photo-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    border-radius: 0.7rem; /* Match the container. */
    margin: 0 !important; /* Ignore prose video spacing. */
    padding: 0 !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  /* Hide the image during playback. */
  .live-photo-container.is-active img {
    opacity: 0;
    box-shadow: none !important;
    transition:
      opacity 0.35s ease,
      box-shadow 0s;
  }

  /* Disable image zoom in the player. */
  .live-photo-container img:hover {
    transform: none !important;
  }

</style>

<script>
  import { getLivePhotoVideoSources, playLivePhoto } from '../lib/live-photo';

  document.addEventListener("DOMContentLoaded", () => {
    const initLivePhotos = () => {
      const specialImages = document.querySelectorAll<HTMLImageElement>(
        '.prose img[data-live="true"], .prose img[data-hdr="true"]',
      );

      specialImages.forEach((img) => {
        if (img.classList.contains("live-processed")) return;
        img.classList.add("live-processed");

        const isLive = img.getAttribute("data-live") === "true";
        const isHdr = img.getAttribute("data-hdr") === "true";

        const container = document.createElement("div");
        container.className = "live-photo-container";

        if (img.parentNode) {
          // Copy the image width.
          const imgWidth = img.getAttribute("width");
          if (imgWidth) {
            container.style.width = imgWidth.includes("%") ? imgWidth : imgWidth + "px";
            container.style.maxWidth = "100%"; // Allow the full width.

            // Match the table cell width.
            const parentElement = img.parentElement;
            if (parentElement?.tagName === "TD") {
              parentElement.style.setProperty(
                "width",
                imgWidth.includes("%") ? imgWidth : imgWidth + "px",
                "important"
              );
            }
          }

          img.parentNode.insertBefore(container, img);
          container.appendChild(img);
          // Remove vertical image spacing.
          img.style.setProperty("margin", "0 auto", "important");
          img.style.setProperty("display", "block", "important");
          
          // Reduce spacing inside table cells.
          if (container.parentElement && container.parentElement.tagName === "TD") {
             container.style.margin = "0.5rem auto";
          }
        }

        if (isHdr) {
          const hdrBadge = document.createElement("div");
          hdrBadge.className = "hdr-badge";
          hdrBadge.innerText = "HDR";
          container.appendChild(hdrBadge);
        }

        if (isLive) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.setAttribute(
            "aria-label",
            document.documentElement.lang.startsWith("en") ? "Play Live Photo" : "播放 Live Photo",
          );
          btn.className = "live-photo-btn";
          btn.innerHTML = '<span class="live-photo-dot"></span>LIVE';
          container.appendChild(btn);

          const video = document.createElement("video");
          video.className = "live-photo-video";
          video.muted = true;
          video.loop = false; // Play once.
          video.playsInline = true;

          const origSrc = img.getAttribute("src") || "";
          const videoSources = getLivePhotoVideoSources(origSrc);

          container.appendChild(video);

          let isPlaying = false;
          let playbackController: AbortController | null = null;

          // Hide the image and its shadow.
          const hideImg = () => {
            img.style.setProperty("opacity", "0", "important");
            img.style.setProperty("visibility", "hidden", "important");
            img.style.setProperty("box-shadow", "none", "important");
          };
          // Restore the image.
          const showImg = () => {
            img.style.removeProperty("opacity");
            img.style.removeProperty("visibility");
            img.style.removeProperty("box-shadow");
          };

          const stopPlayback = () => {
            playbackController?.abort();
            playbackController = null;
            video.pause();
            video.currentTime = 0;
            video.style.opacity = "0";
            video.style.pointerEvents = "none";
            btn.classList.remove("is-playing-btn");
            container.classList.remove("is-active");
            showImg();
            isPlaying = false;
          };

          // Restore the image after playback.
          video.addEventListener("ended", stopPlayback);

          const onPlaySuccess = () => {
            // Show the video with inline styles.
            video.style.opacity = "1";
            video.style.pointerEvents = "auto";
            btn.classList.add("is-playing-btn");
            container.classList.add("is-active");
            hideImg();
            isPlaying = true;
          };

          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();

            if (!isPlaying && !playbackController) {
              const controller = new AbortController();
              playbackController = controller;

              playLivePhoto(video, videoSources, controller.signal)
                .then(() => {
                  if (!controller.signal.aborted && container.isConnected) onPlaySuccess();
                })
                .catch((error) => {
                  if (!controller.signal.aborted) console.error("Playback failed.", error);
                })
                .finally(() => {
                  if (playbackController === controller) playbackController = null;
                });
            } else {
              stopPlayback();
            }
          });
        }
      });
    };

    initLivePhotos();
    document.addEventListener("astro:page-load", initLivePhotos);
  });
</script>
