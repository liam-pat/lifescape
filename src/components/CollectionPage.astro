---
import type { PostEntry } from '../lib/content';
import type { Locale } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import PostGrid from './PostGrid.astro';

interface Props {
	entries: PostEntry[];
	locale: Locale;
	title: string;
	heading: string;
	intro: string;
	emptyMessage: string;
	alternatePath: string;
}

const { entries, locale, title, heading, intro, emptyMessage, alternatePath } = Astro.props;
const sortedEntries = entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={title} locale={locale} alternatePath={alternatePath}>
	<div class="mb-8 bg-black py-10 dark:bg-night-hero">
		<div class="mx-auto max-w-7xl px-4">
			<h1 class="mb-4 text-4xl font-bold text-white md:text-5xl">{heading}</h1>
			<div class="h-28 md:h-16">
				<p class="typewriter text-xl font-medium text-gray-300 md:text-2xl">
					<span class="typewriter-text">{intro}</span>
				</p>
			</div>
		</div>
	</div>

	<main class="mx-auto max-w-7xl px-4">
		{sortedEntries.length > 0 ? (
			<PostGrid entries={sortedEntries} locale={locale} />
		) : (
			<p class="rounded-lg bg-white px-5 py-8 text-center text-gray-600 shadow-sm dark:border dark:border-night-border dark:bg-night-surface dark:text-night-body">
				{emptyMessage}
			</p>
		)}
	</main>
</Layout>
