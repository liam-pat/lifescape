---
import type { CollectionEntry } from 'astro:content';
import { getPostPath, type PostEntry } from '../lib/content';
import { formatShanghaiDate } from '../lib/date';
import { ui, type Locale } from '../lib/i18n';

interface Props {
	entry: PostEntry;
	locale?: Locale;
	showCollectionPrefix?: boolean;
}

const { entry, locale = entry.data.lang, showCollectionPrefix = false } = Astro.props;
const copy = ui[locale];
const readingEntry = entry.collection === 'reading'
	? entry as CollectionEntry<'reading'>
	: null;
const isReading = readingEntry !== null;
const href = getPostPath(entry);
const tags = entry.data.tags ?? [];
const dateLabel = formatShanghaiDate(entry.data.date, locale);
const tagClass = isReading
	? 'border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-800/70 dark:bg-blue-950/45 dark:text-blue-200'
	: entry.collection === 'technology'
		? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800/70 dark:bg-emerald-950/45 dark:text-emerald-200'
		: 'border-purple-200 bg-purple-50 text-purple-700 dark:border-purple-800/70 dark:bg-purple-950/45 dark:text-purple-200';
---

<article class="h-full rounded-lg bg-white shadow-sm shadow-gray-900/5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-gray-900/15 dark:border dark:border-night-border dark:bg-night-surface dark:shadow-black/20 dark:hover:border-[#404752] dark:hover:shadow-black/40">
	<div class="flex h-full flex-col px-4 py-4 md:px-5">
		<div class="mb-2 flex flex-col gap-y-1 sm:flex-row sm:items-start sm:justify-between sm:gap-x-4">
			<h2 class="min-w-0 text-lg font-semibold leading-snug">
				<a href={href} class="line-clamp-2 text-gray-900 hover:text-blue-600 dark:text-night-text dark:hover:text-blue-300">
					{showCollectionPrefix && isReading && <span class="text-gray-500 dark:text-night-muted">{copy.readingPrefix}</span>}{entry.data.title}
				</a>
			</h2>
			<time datetime={entry.data.date.toISOString()} class="shrink-0 text-sm text-gray-500 dark:text-night-muted">
				{dateLabel}
			</time>
		</div>

		{readingEntry?.data.subtitle && (
			<div class="mb-3 flex items-start gap-2 rounded-md bg-gradient-to-r from-blue-50 via-blue-50/70 to-transparent px-3 py-2 dark:from-blue-950/35 dark:via-blue-950/15 dark:to-transparent">
				<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500 dark:bg-blue-400" aria-hidden="true"></span>
				<p class="line-clamp-2 text-sm font-semibold leading-6 text-blue-800 dark:text-blue-100">
					{readingEntry.data.subtitle}
				</p>
			</div>
		)}

		{readingEntry && (
			<div class="mb-2 flex min-w-0 items-center gap-x-3 text-sm">
				<span class="min-w-0 truncate font-medium text-gray-700 dark:text-night-body">
					{readingEntry.data.book.title}
				</span>
				<span class="shrink-0 text-gray-500 dark:text-night-muted">
					{copy.authorLabel}：{readingEntry.data.book.author}
				</span>
				{readingEntry.data.book.rating && (
					<div class="flex shrink-0 text-yellow-500" aria-label={copy.ratingAria(readingEntry.data.book.rating)}>
							{Array.from({ length: readingEntry.data.book.rating }).map(() => (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
							{Array.from({ length: 5 - readingEntry.data.book.rating }).map(() => (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-300 dark:text-gray-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
					</div>
				)}
			</div>
		)}

		{tags.length > 0 && (
			<div class="mb-2 flex flex-wrap gap-1.5">
				{tags.map((tag, index) => (
					<span
						class={`tag-glint inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${tagClass}`}
						style={`--tag-glint-delay: ${index * 180}ms`}
					>
						{tag}
					</span>
				))}
			</div>
		)}

		{entry.data.description && (
			<p class="line-clamp-2 text-sm text-gray-600 dark:text-night-body">
				{entry.data.description}
			</p>
		)}
	</div>
</article>
