---
import type { CollectionEntry } from 'astro:content';
import type { PostEntry } from '../lib/content';
import { formatShanghaiDate } from '../lib/date';

interface Props {
	entry: PostEntry;
	showCollectionPrefix?: boolean;
}

const { entry, showCollectionPrefix = false } = Astro.props;
const readingEntry = entry.collection === 'reading'
	? entry as CollectionEntry<'reading'>
	: null;
const isReading = readingEntry !== null;
const href = `/${entry.collection}/${entry.id}/`;
const tags = entry.data.tags ?? [];
const dateLabel = formatShanghaiDate(entry.data.date);
const tagClass = isReading
	? 'text-blue-700 bg-blue-50 dark:text-blue-300 dark:bg-blue-900'
	: 'text-purple-700 bg-purple-50 dark:text-purple-300 dark:bg-purple-900';
---

<article class="h-full bg-white dark:bg-gray-800 rounded-lg shadow-sm shadow-gray-900/5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-gray-900/15 dark:hover:shadow-black/40">
	<div class="flex h-full flex-col px-4 py-4 md:px-5">
		<div class="mb-2 flex flex-col gap-y-1 sm:flex-row sm:items-start sm:justify-between sm:gap-x-4">
			<h2 class="min-w-0 text-lg font-semibold leading-snug">
				<a href={href} class="line-clamp-2 text-gray-900 hover:text-blue-600 dark:text-white dark:hover:text-blue-400">
					{showCollectionPrefix && isReading && <span class="text-gray-500 dark:text-gray-400">读书有感：</span>}{entry.data.title}
				</a>
			</h2>
			<time datetime={entry.data.date.toISOString()} class="shrink-0 text-sm text-gray-500 dark:text-gray-400">
				{dateLabel}
			</time>
		</div>

		{readingEntry && (
			<div class="mb-2">
				<div class="line-clamp-2 text-sm font-medium text-gray-700 dark:text-gray-300">
					{readingEntry.data.book.title} <span class="text-gray-500 dark:text-gray-400">作者：{readingEntry.data.book.author}</span>
				</div>
				{readingEntry.data.book.rating && (
					<div class="mt-1 flex items-center">
						<div class="flex text-yellow-500" aria-label={`评分 ${readingEntry.data.book.rating}，满分 5 星`}>
							{Array.from({ length: readingEntry.data.book.rating }).map(() => (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
							{Array.from({ length: 5 - readingEntry.data.book.rating }).map(() => (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-300 dark:text-gray-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
						</div>
					</div>
				)}
			</div>
		)}

		{tags.length > 0 && (
			<div class="mb-2 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<span class={`inline-flex items-center rounded px-2 py-0.5 text-xs font-medium ${tagClass}`}>
						{tag}
					</span>
				))}
			</div>
		)}

		{entry.data.description && (
			<p class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">
				{entry.data.description}
			</p>
		)}
	</div>
</article>
