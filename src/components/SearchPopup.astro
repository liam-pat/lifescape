---
import { ui, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const messages = ui[locale].search;
---

<div
  id="search-popup"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label={messages.dialogLabel}
  aria-hidden="true"
  data-locale={locale}
  data-messages={JSON.stringify(messages)}
>
  <!-- Backdrop with blur effect -->
  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="search-backdrop"></div>
  
  <!-- Search container positioned at 1/4 from the top -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
    <div class="overflow-hidden rounded-lg bg-white shadow-xl dark:border dark:border-night-border dark:bg-night-surface dark:shadow-black/50">
      <!-- Search input -->
      <div class="border-b border-gray-200 p-4 dark:border-night-border">
        <div class="relative">
          <input 
            type="text" 
            id="search-input" 
            class="w-full rounded-md border-none bg-gray-100 px-4 py-2 pl-10 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-night-elevated dark:text-night-text dark:focus:ring-blue-400"
            placeholder={messages.placeholder}
            autocomplete="off"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-2.5 h-5 w-5 text-gray-500 dark:text-night-muted" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
          <button type="button" id="search-close" class="absolute right-3 top-2.5 text-gray-500 hover:text-gray-700 dark:text-night-muted dark:hover:text-night-text" aria-label={messages.closeLabel}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search results -->
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-4" aria-live="polite">
        <div class="py-8 text-center text-gray-500 dark:text-night-muted">
          <p>{messages.prompt}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  let pagefindInstance = null;
  let pagefindPromise = null;
  let searchRequestId = 0;
  let previousFocus = null;

  // Elements
  const searchPopup = document.getElementById('search-popup');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchInput = document.getElementById('search-input');
  const searchClose = document.getElementById('search-close');
  const searchResults = document.getElementById('search-results');
  const searchLocale = searchPopup?.dataset.locale === 'en' ? 'en' : 'zh';
  let searchMessages = {};

  try {
    searchMessages = JSON.parse(searchPopup?.dataset.messages || '{}');
  } catch {
    searchMessages = {};
  }

  function message(key, replacements = {}) {
    const template = typeof searchMessages[key] === 'string' ? searchMessages[key] : key;
    return Object.entries(replacements).reduce(
      (text, [name, value]) => text.replaceAll(`{${name}}`, String(value)),
      template,
    );
  }

  function createMessageBlock(message, tone = 'normal') {
    const wrapper = document.createElement('div');
    wrapper.className = `text-center py-8 ${
      tone === 'error'
        ? 'text-red-500 dark:text-red-400'
        : 'text-gray-500 dark:text-night-muted'
    }`;

    const text = document.createElement('p');
    text.textContent = message;
    wrapper.appendChild(text);
    return wrapper;
  }

  function setResultsMessage(message, tone = 'normal') {
    if (!searchResults) return;
    searchResults.replaceChildren(createMessageBlock(message, tone));
  }

  function setResultsError(message, error) {
    if (!searchResults) return;

    const wrapper = createMessageBlock(message, 'error');
    const detail = document.createElement('p');
    detail.className = 'mt-2 text-sm text-gray-500 dark:text-night-muted';
    detail.textContent = error instanceof Error ? error.message : message('unknownError');
    wrapper.appendChild(detail);
    searchResults.replaceChildren(wrapper);
  }

  function normalizeResultUrl(url) {
    if (typeof url !== 'string') return '#';
    const candidate = url.trim();
    if (
      candidate.startsWith('/') ||
      candidate.startsWith('./') ||
      candidate.startsWith('../') ||
      /^https?:\/\//i.test(candidate)
    ) {
      return candidate;
    }
    return '#';
  }

  function createTagPill(tag) {
    const pill = document.createElement('span');
    pill.className = 'rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-800 dark:bg-blue-950/45 dark:text-blue-100';
    pill.textContent = tag;
    return pill;
  }

  function renderSearchResults(results, query) {
    if (!searchResults) return;

    const fragment = document.createDocumentFragment();
    const summary = document.createElement('div');
    summary.className = 'mb-4 text-gray-500 dark:text-night-muted';
    summary.textContent = message('found', { count: results.length, query });
    fragment.appendChild(summary);

    results.forEach((data) => {
      const item = document.createElement('div');
      item.className = 'mb-6 border-b border-gray-200 pb-6 last:border-0 dark:border-night-border';

      const heading = document.createElement('h3');
      heading.className = 'text-lg font-semibold mb-2';

      const link = document.createElement('a');
      link.className = 'text-blue-600 hover:underline dark:text-blue-300';
      link.href = normalizeResultUrl(data?.url);
      link.textContent = typeof data?.meta?.title === 'string' && data.meta.title.trim()
        ? data.meta.title
        : message('untitled');
      heading.appendChild(link);

      const excerpt = document.createElement('p');
      excerpt.className = 'mb-2 text-sm text-gray-600 dark:text-night-body';
      excerpt.textContent = typeof data?.plain_excerpt === 'string' ? data.plain_excerpt : '';

      const tags = document.createElement('div');
      tags.className = 'flex gap-2';
      const rawTags = typeof data?.meta?.tags === 'string' ? data.meta.tags : '';
      rawTags
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
        .forEach((tag) => tags.appendChild(createTagPill(tag)));

      item.append(heading, excerpt, tags);
      fragment.appendChild(item);
    });

    searchResults.replaceChildren(fragment);
  }

  async function loadPagefind() {
    if (pagefindInstance) return pagefindInstance;
    if (pagefindPromise) return pagefindPromise;

    pagefindPromise = import('/pagefind/pagefind.js')
      .then(async (pagefind) => {
        await pagefind.init();
        pagefindInstance = pagefind;
        return pagefind;
      })
      .catch((error) => {
        pagefindPromise = null;
        console.error('Pagefind failed to load:', error);
        setResultsError(message('loadError'), error);
      });

    return pagefindPromise;
  }

  function debounce(func, wait) {
    let timeout;
    return (...args) => {
      clearTimeout(timeout);
      timeout = setTimeout(() => func(...args), wait);
    };
  }

  async function handleSearch(requestId) {
    if (requestId !== searchRequestId || !pagefindInstance || !searchInput || !searchResults) return;

    const query = searchInput.value.trim();

    if (!query) {
      setResultsMessage(message('prompt'));
      return;
    }

    setResultsMessage(message('searching'));

    try {
      const search = await pagefindInstance.search(query, {
        filters: { language: searchLocale },
      });
      if (requestId !== searchRequestId) return;

      if (search.results.length === 0) {
        setResultsMessage(message('notFound', { query }));
        return;
      }

      const resultData = await Promise.all(search.results.map((result) => result.data()));
      if (requestId !== searchRequestId) return;
      renderSearchResults(resultData, query);
    } catch (error) {
      if (requestId !== searchRequestId) return;
      console.error('Search failed:', error);
      setResultsError(message('searchError'), error);
    }
  }

  const debouncedSearch = debounce(handleSearch, 300);

  // Function to open search popup
  function openSearchPopup() {
    if (searchPopup) {
      previousFocus = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
      searchPopup.classList.remove('hidden');
      searchPopup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      searchInput?.focus();
      
      loadPagefind().then((pagefind) => {
        if (!pagefind) return;
        if (searchInput?.value.trim()) {
          const requestId = ++searchRequestId;
          debouncedSearch(requestId);
        }
      });
    }
  }

  // Function to close search popup
  function closeSearchPopup() {
    if (searchPopup) {
      searchRequestId++;
      searchPopup.classList.add('hidden');
      searchPopup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      
      // Clear the search input
      if (searchInput) {
        searchInput.value = '';
      }
      
      // Reset search results
      if (searchResults) {
        setResultsMessage(message('prompt'));
      }
      previousFocus?.focus();
      previousFocus = null;
    }
  }

  function trapFocus(event) {
    if (event.key !== 'Tab' || !searchPopup || searchPopup.classList.contains('hidden')) return;

    const focusable = Array.from(
      searchPopup.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')
    ).filter((element) => element.getClientRects().length > 0);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  searchBackdrop?.addEventListener('click', closeSearchPopup);
  searchClose?.addEventListener('click', closeSearchPopup);
  searchInput?.addEventListener('input', () => {
    const requestId = ++searchRequestId;
    debouncedSearch(requestId);
  });
  document.addEventListener('keydown', (event) => {
    trapFocus(event);
    if (event.key === 'Escape' && searchPopup && !searchPopup.classList.contains('hidden')) {
      closeSearchPopup();
    }
  });
  window.openSearchPopup = openSearchPopup;
</script>
