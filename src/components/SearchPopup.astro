<div
  id="search-popup"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="站内搜索"
  aria-hidden="true"
>
  <!-- Backdrop with blur effect -->
  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="search-backdrop"></div>
  
  <!-- Search container positioned at 1/4 from the top -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl overflow-hidden">
      <!-- Search input -->
      <div class="p-4 border-b border-gray-200 dark:border-gray-700">
        <div class="relative">
          <input 
            type="text" 
            id="search-input" 
            class="w-full px-4 py-2 pl-10 bg-gray-100 dark:bg-gray-700 border-none rounded-md focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:outline-none dark:text-white"
            placeholder="输入关键词搜索"
            autocomplete="off"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 dark:text-gray-400 absolute left-3 top-2.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
          <button type="button" id="search-close" class="absolute right-3 top-2.5 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300" aria-label="关闭搜索">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search results -->
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-4" aria-live="polite">
        <div class="text-center text-gray-500 dark:text-gray-400 py-8">
          <p>输入关键词开始搜索</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  let pagefindInstance = null;
  let pagefindPromise = null;
  let searchRequestId = 0;
  let previousFocus = null;

  // Elements
  const searchPopup = document.getElementById('search-popup');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchInput = document.getElementById('search-input');
  const searchClose = document.getElementById('search-close');
  const searchResults = document.getElementById('search-results');

  function createMessageBlock(message, tone = 'normal') {
    const wrapper = document.createElement('div');
    wrapper.className = `text-center py-8 ${
      tone === 'error'
        ? 'text-red-500 dark:text-red-400'
        : 'text-gray-500 dark:text-gray-400'
    }`;

    const text = document.createElement('p');
    text.textContent = message;
    wrapper.appendChild(text);
    return wrapper;
  }

  function setResultsMessage(message, tone = 'normal') {
    if (!searchResults) return;
    searchResults.replaceChildren(createMessageBlock(message, tone));
  }

  function setResultsError(message, error) {
    if (!searchResults) return;

    const wrapper = createMessageBlock(message, 'error');
    const detail = document.createElement('p');
    detail.className = 'mt-2 text-sm text-gray-500 dark:text-gray-400';
    detail.textContent = error instanceof Error ? error.message : '未知错误';
    wrapper.appendChild(detail);
    searchResults.replaceChildren(wrapper);
  }

  function normalizeResultUrl(url) {
    if (typeof url !== 'string') return '#';
    const candidate = url.trim();
    if (
      candidate.startsWith('/') ||
      candidate.startsWith('./') ||
      candidate.startsWith('../') ||
      /^https?:\/\//i.test(candidate)
    ) {
      return candidate;
    }
    return '#';
  }

  function createTagPill(tag) {
    const pill = document.createElement('span');
    pill.className = 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100 text-xs px-2 py-0.5 rounded-full';
    pill.textContent = tag;
    return pill;
  }

  function renderSearchResults(results, query) {
    if (!searchResults) return;

    const fragment = document.createDocumentFragment();
    const summary = document.createElement('div');
    summary.className = 'mb-4 text-gray-500 dark:text-gray-400';
    summary.textContent = `找到 ${results.length} 个符合“${query}”的结果`;
    fragment.appendChild(summary);

    results.forEach((data) => {
      const item = document.createElement('div');
      item.className = 'mb-6 pb-6 border-b border-gray-200 dark:border-gray-700 last:border-0';

      const heading = document.createElement('h3');
      heading.className = 'text-lg font-semibold mb-2';

      const link = document.createElement('a');
      link.className = 'text-blue-600 dark:text-blue-400 hover:underline';
      link.href = normalizeResultUrl(data?.url);
      link.textContent = typeof data?.meta?.title === 'string' && data.meta.title.trim()
        ? data.meta.title
        : '无标题';
      heading.appendChild(link);

      const excerpt = document.createElement('p');
      excerpt.className = 'text-gray-600 dark:text-gray-300 text-sm mb-2';
      excerpt.textContent = typeof data?.plain_excerpt === 'string' ? data.plain_excerpt : '';

      const tags = document.createElement('div');
      tags.className = 'flex gap-2';
      const rawTags = typeof data?.meta?.tags === 'string' ? data.meta.tags : '';
      rawTags
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
        .forEach((tag) => tags.appendChild(createTagPill(tag)));

      item.append(heading, excerpt, tags);
      fragment.appendChild(item);
    });

    searchResults.replaceChildren(fragment);
  }

  async function loadPagefind() {
    if (pagefindInstance) return pagefindInstance;
    if (pagefindPromise) return pagefindPromise;

    pagefindPromise = import('/pagefind/pagefind.js')
      .then(async (pagefind) => {
        await pagefind.init();
        pagefindInstance = pagefind;
        return pagefind;
      })
      .catch((error) => {
        pagefindPromise = null;
        console.error('Pagefind 加载失败:', error);
        setResultsError('搜索功能加载失败', error);
      });

    return pagefindPromise;
  }

  function debounce(func, wait) {
    let timeout;
    return (...args) => {
      clearTimeout(timeout);
      timeout = setTimeout(() => func(...args), wait);
    };
  }

  async function handleSearch(requestId) {
    if (requestId !== searchRequestId || !pagefindInstance || !searchInput || !searchResults) return;

    const query = searchInput.value.trim();

    if (!query) {
      setResultsMessage('输入关键词开始搜索');
      return;
    }

    setResultsMessage('搜索中...');

    try {
      const search = await pagefindInstance.search(query);
      if (requestId !== searchRequestId) return;

      if (search.results.length === 0) {
        setResultsMessage(`找不到符合“${query}”的结果`);
        return;
      }

      const resultData = await Promise.all(search.results.map((result) => result.data()));
      if (requestId !== searchRequestId) return;
      renderSearchResults(resultData, query);
    } catch (error) {
      if (requestId !== searchRequestId) return;
      console.error('搜索失败:', error);
      setResultsError('搜索过程中发生错误', error);
    }
  }

  const debouncedSearch = debounce(handleSearch, 300);

  // Function to open search popup
  function openSearchPopup() {
    if (searchPopup) {
      previousFocus = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
      searchPopup.classList.remove('hidden');
      searchPopup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      searchInput?.focus();
      
      loadPagefind().then((pagefind) => {
        if (!pagefind) return;
        if (searchInput?.value.trim()) {
          const requestId = ++searchRequestId;
          debouncedSearch(requestId);
        }
      });
    }
  }

  // Function to close search popup
  function closeSearchPopup() {
    if (searchPopup) {
      searchRequestId++;
      searchPopup.classList.add('hidden');
      searchPopup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      
      // Clear the search input
      if (searchInput) {
        searchInput.value = '';
      }
      
      // Reset search results
      if (searchResults) {
        setResultsMessage('输入关键词开始搜索');
      }
      previousFocus?.focus();
      previousFocus = null;
    }
  }

  function trapFocus(event) {
    if (event.key !== 'Tab' || !searchPopup || searchPopup.classList.contains('hidden')) return;

    const focusable = Array.from(
      searchPopup.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')
    ).filter((element) => element.getClientRects().length > 0);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  searchBackdrop?.addEventListener('click', closeSearchPopup);
  searchClose?.addEventListener('click', closeSearchPopup);
  searchInput?.addEventListener('input', () => {
    const requestId = ++searchRequestId;
    debouncedSearch(requestId);
  });
  document.addEventListener('keydown', (event) => {
    trapFocus(event);
    if (event.key === 'Escape' && searchPopup && !searchPopup.classList.contains('hidden')) {
      closeSearchPopup();
    }
  });
  window.openSearchPopup = openSearchPopup;
</script>
