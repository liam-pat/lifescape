---
import { formatShanghaiDate } from '../lib/date';
import type { PostEntry } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props {
	entry: PostEntry;
	locale?: Locale;
	tagClass: string;
}

const { entry, locale = entry.data.lang, tagClass } = Astro.props;
---

<time datetime={entry.data.date.toISOString()} class="shrink-0">
	{formatShanghaiDate(entry.data.date, locale)}
</time>
{entry.data.tags.length > 0 && (
	<div
		class="flex flex-wrap gap-1.5 md:gap-2"
		data-pagefind-meta={`tags:${entry.data.tags.join(',')}`}
	>
		{entry.data.tags.map((tag, index) => (
			<span
				class={`tag-glint inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide md:px-3 md:text-sm ${tagClass}`}
				style={`--tag-glint-delay: ${index * 180}ms`}
			>
				{tag}
			</span>
		))}
	</div>
)}
