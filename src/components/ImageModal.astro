---
import { ui, type Locale } from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = ui[locale].image;
---

<div
	data-image-modal
	data-zoom-label={copy.zoomLabel}
	class="fixed inset-0 z-50 items-center justify-center cursor-zoom-out"
	role="dialog"
	aria-modal="true"
	aria-label={copy.previewLabel}
	aria-hidden="true"
	tabindex="-1"
>
	<div data-modal-wrapper class="modal-image-wrapper">
		<img data-modal-image class="object-contain" src="" alt="" />
		<video data-modal-video class="object-contain" muted playsinline></video>
		<div data-modal-hdr class="hdr-badge hidden">HDR</div>
		<button type="button" data-modal-live-btn class="live-photo-btn hidden" aria-label={copy.playLivePhotoLabel}><span class="live-photo-dot"></span>LIVE</button>
	</div>
	<div data-modal-meta class="image-meta" aria-live="polite">
		<span data-modal-meta-text></span>
	</div>
</div>

<style>
  [data-image-modal] {
    display: flex;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    padding: 1.5rem;
    transition: opacity 200ms ease, visibility 0ms linear 200ms;
  }

  [data-image-modal].is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 220ms ease;
  }

  [data-image-modal] .modal-image-wrapper {
    position: relative;
    display: flex;
    max-width: min(92vw, 1200px);
    max-height: 88vh;
    border-radius: 0.75rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transform: scale(0.96);
    transition: transform 220ms ease;
    will-change: transform;
    background: transparent;
  }

  [data-image-modal].is-open .modal-image-wrapper {
    transform: scale(1);
  }

  [data-image-modal] .modal-image-wrapper img,
  [data-image-modal] .modal-image-wrapper video {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 88vh;
    border-radius: 0.75rem;
  }

  [data-image-modal] .modal-image-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  [data-image-modal] .modal-image-wrapper video.is-playing {
    opacity: 1;
    pointer-events: auto;
  }
  
  .hidden {
    display: none !important;
  }

  [data-image-modal] [data-modal-meta] {
    position: absolute;
    left: 50%;
    bottom: calc(1.1rem - 6px);
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.92);
    color: #111827;
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.45rem 0.75rem;
    border-radius: 0.6rem;
    max-width: min(92vw, 900px);
    white-space: nowrap;
    overflow-x: auto;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease, bottom 200ms ease;
  }

  [data-image-modal] [data-modal-meta].is-visible {
    opacity: 1;
    bottom: 1.1rem;
  }

  @media (max-width: 768px) {
    [data-image-modal] {
      padding: 0.75rem;
    }

    [data-image-modal] .modal-image-wrapper {
      max-width: 94vw;
      max-height: 84vh;
    }
    [data-image-modal] .modal-image-wrapper img,
    [data-image-modal] .modal-image-wrapper video {
      max-width: 94vw;
      max-height: 84vh;
    }

    [data-image-modal] [data-modal-meta] {
      bottom: 0.7rem;
      max-width: 94vw;
    }
  }
</style>

<script>
  import { getExifData, formatExifData } from '../lib/exif';
  import { getLivePhotoVideoSources, playLivePhoto } from '../lib/live-photo';

  // Find all article images.
  const images = document.querySelectorAll('.prose img');
  const modal = document.querySelector('[data-image-modal]') as HTMLDivElement | null;
  const modalImg = modal?.querySelector('[data-modal-image]') as HTMLImageElement | null;
  const modalVideo = modal?.querySelector('[data-modal-video]') as HTMLVideoElement | null;
  const modalHdr = modal?.querySelector('[data-modal-hdr]') as HTMLDivElement | null;
  const modalLiveBtn = modal?.querySelector('[data-modal-live-btn]') as HTMLButtonElement | null;
  const metaBox = modal?.querySelector('[data-modal-meta]') as HTMLDivElement | null;
  const metaText = modal?.querySelector('[data-modal-meta-text]') as HTMLSpanElement | null;
  
  let activeSrc = '';
  let currentVideoSources: string[] = [];
  let isVideoPlaying = false;
  let hideMetaTimer: number | undefined;
  let previousFocus: HTMLElement | null = null;
  let playbackController: AbortController | null = null;
  const inertElements = new Set<HTMLElement>();

  if (modal && modalImg && metaBox && metaText) {
    const setBackgroundInert = () => {
      let current: HTMLElement = modal;

      while (current.parentElement) {
        for (const sibling of current.parentElement.children) {
          if (sibling !== current && sibling instanceof HTMLElement && !sibling.inert) {
            sibling.inert = true;
            inertElements.add(sibling);
          }
        }

        if (current.parentElement === document.body) break;
        current = current.parentElement;
      }
    };

    const restoreBackground = () => {
      inertElements.forEach((element) => {
        element.inert = false;
      });
      inertElements.clear();
    };

    const stopPlayback = () => {
      playbackController?.abort();
      playbackController = null;
      modalVideo?.pause();
      modalVideo?.classList.remove('is-playing');
      modalLiveBtn?.classList.remove('is-playing-btn');
      isVideoPlaying = false;
    };

    const setMetaState = (text: string, isVisible: boolean) => {
      metaText.textContent = text;
      // Remove old metadata fields.
      while (metaText.firstElementChild) {
        metaText.firstElementChild.remove();
      }
      metaBox.classList.toggle('is-visible', isVisible);
    };

    const displayMetaFields = (fields: { key: string; value: string }[]) => {
      metaText.textContent = '';
      const fragment = document.createDocumentFragment();
      
      fields
        .filter((field) => field.value)
        .forEach((field, index) => {
          if (index > 0) fragment.appendChild(document.createTextNode(' · '));
          
          const key = document.createElement('span');
          key.className = 'font-normal text-gray-400';
          key.textContent = field.key;
          
          const value = document.createElement('strong');
          value.textContent = field.value;
          
          fragment.append(key, document.createTextNode(' '), value);
        });
        
      metaText.appendChild(fragment);
      metaBox.classList.add('is-visible');
    };

    const openModal = async (img: HTMLImageElement) => {
      if (hideMetaTimer !== undefined) {
        window.clearTimeout(hideMetaTimer);
        hideMetaTimer = undefined;
      }

      previousFocus = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
      activeSrc = img.src;
      modalImg.src = img.src;
      modalImg.alt = img.alt;
      
      const isLive = img.getAttribute('data-live') === 'true';
      const isHdr = img.getAttribute('data-hdr') === 'true';

      if (isHdr && modalHdr) modalHdr.classList.remove('hidden');
      else if (modalHdr) modalHdr.classList.add('hidden');

      if (isLive && modalLiveBtn) {
        modalLiveBtn.classList.remove('hidden');
        currentVideoSources = getLivePhotoVideoSources(img.src);
      } else if (modalLiveBtn) {
        modalLiveBtn.classList.add('hidden');
        currentVideoSources = [];
      }
      
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setBackgroundInert();
      modal.focus();

      setMetaState('Reading metadata...', true);

      const meta = await getExifData(activeSrc);
      
      // Ignore stale metadata.
      if (activeSrc !== img.src || !modal.classList.contains('is-open')) return;

      if (!meta) {
        setMetaState('Metadata unavailable', true);
        return;
      }

      const fields = formatExifData(meta);
      if (fields.length === 0) {
        setMetaState('Metadata unavailable', true);
        return;
      }

      displayMetaFields(fields);
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      activeSrc = '';
      stopPlayback();
      restoreBackground();
      
      if (modalVideo) {
        // Release the video resources.
        modalVideo.removeAttribute('src');
        modalVideo.load(); // Reset the media element.
      }
      
      // Hide metadata after the fade.
      hideMetaTimer = window.setTimeout(() => {
        setMetaState('', false);
        hideMetaTimer = undefined;
      }, 200);
      previousFocus?.focus();
      previousFocus = null;
    };

    // Bind image events.
    images.forEach(img => {
      if (img instanceof HTMLImageElement) {
        img.addEventListener('click', () => openModal(img));
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        const zoomLabel = modal.dataset.zoomLabel || 'View full-size image';
        img.setAttribute('aria-label', img.alt ? `${zoomLabel}: ${img.alt}` : zoomLabel);
        img.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openModal(img);
          }
        });
      }
    });

    modal.addEventListener('click', closeModal);
    modalImg.addEventListener('click', closeModal);
    if (modalVideo) modalVideo.addEventListener('click', closeModal);

    if (modalLiveBtn && modalVideo) {
      // Reset after one playback.
      modalVideo.addEventListener('ended', () => {
        modalVideo.classList.remove('is-playing');
        modalLiveBtn.classList.remove('is-playing-btn');
        isVideoPlaying = false;
      });

      modalLiveBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!isVideoPlaying && !playbackController) {
          const controller = new AbortController();
          playbackController = controller;

          playLivePhoto(modalVideo, currentVideoSources, controller.signal)
            .then(() => {
              if (controller.signal.aborted || !modal.classList.contains('is-open')) return;
              modalVideo.classList.add('is-playing');
              modalLiveBtn.classList.add('is-playing-btn');
              isVideoPlaying = true;
            })
            .catch((error) => {
              if (!controller.signal.aborted) console.error('Playback failed.', error);
            })
            .finally(() => {
              if (playbackController === controller) playbackController = null;
            });
        } else {
          stopPlayback();
          modalVideo.currentTime = 0;
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && modal.classList.contains('is-open')) {
        const focusable = [
          modal,
          ...Array.from(modal.querySelectorAll<HTMLElement>('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'))
            .filter((element) => element.getClientRects().length > 0),
        ];
        const currentIndex = focusable.indexOf(document.activeElement as HTMLElement);
        const nextIndex = e.shiftKey
          ? (currentIndex <= 0 ? focusable.length - 1 : currentIndex - 1)
          : (currentIndex === focusable.length - 1 ? 0 : currentIndex + 1);

        e.preventDefault();
        focusable[nextIndex]?.focus();
      }

      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  }
</script>
