---
import { getCollection, render } from 'astro:content';
import ArticlePage from '../../../layouts/ArticlePage.astro';
import { getPostSlug } from '../../../lib/content';

export async function getStaticPaths() {
	const entries = await getCollection('life', ({ data }) => data.lang === 'en');
	return entries.map((entry) => ({
		params: { slug: getPostSlug(entry) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticlePage entry={entry} headings={headings}>
	<Content />
</ArticlePage>
