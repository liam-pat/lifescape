---
import { getCollection } from 'astro:content';
import CollectionPage from '../../components/CollectionPage.astro';

const readingEntries = await getCollection('reading', ({ data }) => data.lang === 'zh');
---

<CollectionPage
	entries={readingEntries}
	locale="zh"
	title="My Reading"
	heading="Reading"
	intro={`落叶寄相思，三叶不言中，送君三捆扎，吾愿等三季。\n我赠你当下春绿，夏红，秋黄；余生，妳欠我冬季白首。`}
	emptyMessage="读书文章整理中。"
	alternatePath="/en/reading/"
/>
