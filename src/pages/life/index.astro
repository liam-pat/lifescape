---
import { getCollection } from 'astro:content';
import CollectionPage from '../../components/CollectionPage.astro';

const lifeEntries = await getCollection('life', ({ data }) => data.lang === 'zh');
---

<CollectionPage
	entries={lifeEntries}
	locale="zh"
	title="My Life"
	heading="Life"
	intro="这个世界只有一种成功，用自己喜欢的方式过一生。"
	emptyMessage="生活文章整理中。"
	alternatePath="/en/life/"
/>
