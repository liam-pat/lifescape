---
import { getCollection } from 'astro:content';
import CollectionPage from '../../components/CollectionPage.astro';

const technologyEntries = await getCollection('technology', ({ data }) => data.lang === 'zh');
---

<CollectionPage
	entries={technologyEntries}
	locale="zh"
	title="My Technology"
	heading="Technology"
	intro="记录技术实践、问题与解决方案。"
	emptyMessage="技术文章整理中。"
	alternatePath="/en/technology/"
/>
