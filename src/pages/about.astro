</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Element refs (single source of truth) ────────────────────────────
    const sceneEl     = document.getElementById('card-scene-outer');
    const tiltInner   = document.getElementById('card-tilt-inner');
    const cardWrapper = document.getElementById('card-wrapper');
    const overlay     = document.getElementById('crack-overlay');
    const flash       = document.getElementById('crack-flash');
    const crackSvg    = document.getElementById('crack-svg');
    const crackGroup   = document.getElementById('crack-group');
    const btnWechat   = document.getElementById('btn-wechat');
    const btnAlipay   = document.getElementById('btn-alipay');
    const btnCrypto   = document.getElementById('btn-crypto');
    const qrWechat    = document.getElementById('qr-wechat');
    const qrAlipay    = document.getElementById('qr-alipay');
    const qrCrypto    = document.getElementById('qr-crypto');

    if (!tiltInner || !cardWrapper) return;

    // ── Card throw + screen smash ─────────────────────────────────────────
    function triggerImpact() {
      // Position crack origin over the card
      if (crackGroup && sceneEl && crackSvg) {
        const rect = sceneEl.getBoundingClientRect();
        const clientX = rect.left + rect.width / 2;
        const clientY = rect.top + rect.height * 0.38;

        try {
          // 利用矩阵逆变换，获取精确的 SVG 空间坐标
          const pt = crackSvg.createSVGPoint();
          pt.x = clientX;
          pt.y = clientY;
          const ctm = crackSvg.getScreenCTM();
          if (ctm) {
            const svgPoint = pt.matrixTransform(ctm.inverse());
            const dx = svgPoint.x - 720;
            const dy = svgPoint.y - 400;
            crackGroup.setAttribute('transform', `translate(${dx.toFixed(1)}, ${dy.toFixed(1)})`);
          }
        } catch (e) {
          // 健壮性降级方案：如果矩阵变换失败，使用原比例公式转换并应用 translate
          const dx = ((clientX) / window.innerWidth * 1440) - 720;
          const dy = ((clientY) / window.innerHeight * 900) - 400;
          crackGroup.setAttribute('transform', `translate(${dx.toFixed(0)}, ${dy.toFixed(0)})`);
        }
      }

      // Sound synthesis
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (AudioCtx) {
          const audioCtx = new AudioCtx();
          // Low thud
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(120, audioCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(30, audioCtx.currentTime + 0.18);
          gain.gain.setValueAtTime(0.9, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
          osc.connect(gain); gain.connect(audioCtx.destination);
          osc.start(); osc.stop(audioCtx.currentTime + 0.3);
          // Crack snap (filtered noise)
          const bufSize = audioCtx.sampleRate * 0.15;
          const noiseBuffer = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
          const data = noiseBuffer.getChannelData(0);
          for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
          const noiseSource = audioCtx.createBufferSource();
          noiseSource.buffer = noiseBuffer;
          const noiseGain = audioCtx.createGain();
          noiseGain.gain.setValueAtTime(0.35, audioCtx.currentTime);
          noiseGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
          const hpf = audioCtx.createBiquadFilter();
          hpf.type = 'highpass'; hpf.frequency.value = 1800;
          noiseSource.connect(hpf); hpf.connect(noiseGain); noiseGain.connect(audioCtx.destination);
          noiseSource.start(); noiseSource.stop(audioCtx.currentTime + 0.15);
        }
      } catch(e) { /* audio not critical */ }

      // Visual
      overlay.classList.add('impact');
      flash.classList.add('flash');
      document.body.classList.add('shaking');
      setTimeout(() => document.body.classList.remove('shaking'), 600);
      setTimeout(() => {
        flash.classList.remove('flash');
        flash.classList.add('flash-out');
        crackSvg.classList.add('visible');
      }, 55);
    }

    function runThrowSequence() {
      if (!sceneEl || !overlay) return;
      // Lock scroll synchronously — before any frame renders
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      // Flat timeline (all relative to T=0)
      const T = 300;
      setTimeout(() => sceneEl.classList.add('throwing'),         T);
      setTimeout(() => triggerImpact(),                           T + 680);
      setTimeout(() => {
        overlay.classList.add('fading');
        sceneEl.classList.remove('throwing');
        sceneEl.style.opacity = ''; // clear inline opacity:0 so .settled wins
        sceneEl.classList.add('settled');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      },                                                          T + 680 + 950);
      setTimeout(() => overlay.style.display = 'none',           T + 680 + 2900);
    }

    runThrowSequence();

    // Double-click to replay
    sceneEl?.addEventListener('dblclick', () => {
      overlay.style.display = '';
      overlay.classList.remove('fading', 'impact');
      crackSvg.classList.remove('visible');
      crackGroup?.removeAttribute('transform'); // 重置裂纹偏移量
      flash.classList.remove('flash', 'flash-out');
      sceneEl.classList.remove('settled', 'throwing');
      sceneEl.style.opacity = '0';
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      setTimeout(runThrowSequence, 100);
    });

    // ── Card flip ─────────────────────────────────────────────────────────
    function doFlip(e) {
      if (e) e.stopPropagation();
      tiltInner.classList.add('flipping');
      cardWrapper.classList.toggle('is-flipped');
      setTimeout(() => tiltInner.classList.remove('flipping'), 750);
    }
    document.getElementById('btn-flip-front')?.addEventListener('click', doFlip);
    document.getElementById('btn-flip-back')?.addEventListener('click', doFlip);

    // ── Mouse tilt ────────────────────────────────────────────────────────
    sceneEl?.addEventListener('mousemove', (e) => {
      const rect = sceneEl.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      tiltInner.classList.add('tilting');
      tiltInner.style.transform = `rotateX(${-((y - rect.height / 2) / (rect.height / 2)) * 12}deg) rotateY(${((x - rect.width / 2) / (rect.width / 2)) * 12}deg)`;
      sceneEl.style.setProperty('--glare-x', (x / rect.width  * 100) + '%');
      sceneEl.style.setProperty('--glare-y', (y / rect.height * 100) + '%');
    });
    sceneEl?.addEventListener('mouseleave', () => {
      tiltInner.classList.remove('tilting');
      tiltInner.style.transform = '';
    });

    // ── Payment tabs ──────────────────────────────────────────────────────
    function clearTabs() {
      [btnWechat, btnAlipay, btnCrypto].forEach(b =>
        b?.classList.remove('pay-tab-wechat-active', 'pay-tab-alipay-active', 'pay-tab-crypto-active')
      );
      [qrWechat, qrAlipay, qrCrypto].forEach(q => { if (q) q.style.display = 'none'; });
    }
    btnWechat?.addEventListener('click', (e) => { e.stopPropagation(); clearTabs(); btnWechat.classList.add('pay-tab-wechat-active'); if (qrWechat) qrWechat.style.display = 'block'; });
    btnAlipay?.addEventListener('click', (e) => { e.stopPropagation(); clearTabs(); btnAlipay.classList.add('pay-tab-alipay-active'); if (qrAlipay) qrAlipay.style.display = 'block'; });
    btnCrypto?.addEventListener('click', (e) => { e.stopPropagation(); clearTabs(); btnCrypto.classList.add('pay-tab-crypto-active'); if (qrCrypto) qrCrypto.style.display = 'block'; });

    // ── Copy BTC address ──────────────────────────────────────────────────
    document.getElementById('btn-copy-addr')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const addr = document.getElementById('btc-addr')?.textContent?.trim();
      if (!addr) return;
      navigator.clipboard.writeText(addr).then(() => {
        const btn = document.getElementById('btn-copy-addr');
        btn.classList.add('copied');
        btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>`;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
        }, 1500);
      });
    });
  });
</script>
