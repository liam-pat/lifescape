---
import Layout from '../layouts/Layout.astro';

const topics = [
	{
		index: '01',
		title: 'Life',
		description: '记录旅途、选择与日常，也记录每个阶段看待世界的方式。',
		href: '/life/',
		accent: 'bg-purple-500',
	},
	{
		index: '02',
		title: 'Reading',
		description: '留下读书时真正触动我的观点，方便日后重新理解与审视。',
		href: '/reading/',
		accent: 'bg-blue-500',
	},
	{
		index: '03',
		title: 'Technology',
		description: '整理开发实践、解决问题的过程，以及值得反复使用的方法。',
		href: '/technology/',
		accent: 'bg-emerald-500',
	},
];

const reasons = [
	{
		number: '01',
		title: '整理',
		description: '把模糊的想法写清楚，往往也是重新认识它的过程。',
	},
	{
		number: '02',
		title: '记录',
		description: '给经历留下坐标，看看自己在不同阶段如何思考与选择。',
	},
	{
		number: '03',
		title: '重读',
		description: '在需要的时候回到这里，找回当时的经验和理解。',
	},
];
---

<Layout title="About · VERSION.ME">
	<main>
		<section class="bg-black text-white">
			<div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 md:grid-cols-[minmax(0,1fr)_18rem] md:items-end md:py-24">
				<div class="max-w-3xl">
					<p class="mb-5 text-sm font-semibold uppercase tracking-[0.24em] text-gray-400">
						About / VERSION.ME
					</p>
					<h1 class="text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">
						Mr.Pat <span class="text-gray-500">Liam</span>
					</h1>
					<p class="mt-7 max-w-2xl text-lg leading-8 text-gray-300 md:text-xl">
						Creator &amp; Developer。这里记录生活、阅读与技术，也记录我理解世界的方式。
					</p>
				</div>

				<div class="border-l border-gray-700 pl-5">
					<p class="text-sm uppercase tracking-[0.2em] text-gray-500">A note to myself</p>
					<p class="mt-3 text-base leading-7 text-gray-300">
						看见一座山，就想知道山后面是什么。
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-4 py-14 md:py-20">
			<div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
						This space
					</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
						我在这里写什么
					</h2>
					<p class="mt-4 text-base leading-7 text-gray-600 dark:text-gray-300">
						不追求完整答案，只保留真实经历和当下值得记住的思考。
					</p>
				</div>

				<div class="divide-y divide-gray-300 border-y border-gray-300 dark:divide-gray-700 dark:border-gray-700">
					{topics.map((topic) => (
						<a
							href={topic.href}
							class="group grid gap-4 py-6 transition-colors hover:bg-white/60 dark:hover:bg-gray-800/40 sm:grid-cols-[3rem_10rem_minmax(0,1fr)_2rem] sm:items-center sm:px-3"
						>
							<div class="flex items-center gap-3 sm:block">
								<span class={`inline-block h-2.5 w-2.5 rounded-full ${topic.accent}`}></span>
								<span class="text-sm tabular-nums text-gray-400 sm:hidden">{topic.index}</span>
							</div>
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white">{topic.title}</h3>
							<p class="text-base leading-7 text-gray-600 dark:text-gray-300">{topic.description}</p>
							<span class="hidden text-xl text-gray-400 transition-transform group-hover:translate-x-1 sm:block" aria-hidden="true">→</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="border-y border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-800">
			<div class="mx-auto max-w-7xl px-4 py-14 md:py-20">
				<div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
							Why write
						</p>
						<h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
							为什么写下来
						</h2>
					</div>

					<ol class="grid gap-px overflow-hidden rounded-lg border border-gray-300 bg-gray-300 dark:border-gray-700 dark:bg-gray-700 md:grid-cols-3">
						{reasons.map((reason) => (
							<li class="bg-[#E8E8E8] p-6 dark:bg-gray-900 md:p-7">
								<span class="text-sm font-semibold tabular-nums text-gray-400">{reason.number}</span>
								<h3 class="mt-8 text-xl font-semibold text-gray-900 dark:text-white">{reason.title}</h3>
								<p class="mt-3 text-base leading-7 text-gray-600 dark:text-gray-300">{reason.description}</p>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-4 py-14 md:py-20">
			<div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
						Support
					</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
						请我喝杯咖啡
					</h2>
					<p class="mt-4 text-base leading-7 text-gray-600 dark:text-gray-300">
						如果这里的内容曾经帮到你，可以用一杯咖啡支持我继续写下去。
					</p>
				</div>

				<details class="group rounded-lg border border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-800">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-base font-semibold text-gray-900 marker:hidden dark:text-white md:px-7">
						<span>查看赞赏方式</span>
						<span class="text-xl text-gray-400 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
					</summary>
					<div class="grid gap-4 border-t border-gray-200 p-5 dark:border-gray-700 md:grid-cols-2 md:p-7">
						<figure class="rounded-lg bg-gray-100 p-4 text-center dark:bg-gray-900">
							<img
								src="https://hk-saver.s3.ap-east-1.amazonaws.com/images/payments/wechatpay-2026.jpg"
								alt="微信收款码"
								class="mx-auto aspect-square w-full max-w-56 rounded-md object-contain"
								loading="lazy"
							/>
							<figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-300">微信</figcaption>
						</figure>
						<figure class="rounded-lg bg-gray-100 p-4 text-center dark:bg-gray-900">
							<img
								src="https://hk-saver.s3.ap-east-1.amazonaws.com/images/payments/alipay-2026.jpg"
								alt="支付宝收款码"
								class="mx-auto aspect-square w-full max-w-56 rounded-md object-contain"
								loading="lazy"
							/>
							<figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-300">支付宝</figcaption>
						</figure>
					</div>
				</details>
			</div>
		</section>
	</main>
</Layout>
