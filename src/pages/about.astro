---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me">

  <!-- ===== Screen Crack Overlay ===== -->
  <div id="crack-overlay" aria-hidden="true">
    <!-- White impact flash -->
    <div id="crack-flash"></div>
    <!-- SVG crack lines -->
    <svg id="crack-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g id="crack-group">
        <!-- Main radial cracks from impact center -->
        <g id="crack-lines" stroke="white" stroke-linecap="round" fill="none">
          <!-- Primary long cracks -->
          <path d="M720,400 L340,80" stroke-width="2.5" opacity="0.9"/>
          <path d="M720,400 L1100,60" stroke-width="2" opacity="0.85"/>
          <path d="M720,400 L1420,320" stroke-width="2.2" opacity="0.9"/>
          <path d="M720,400 L1380,700" stroke-width="2" opacity="0.8"/>
          <path d="M720,400 L900,900" stroke-width="2.5" opacity="0.9"/>
          <path d="M720,400 L420,880" stroke-width="2" opacity="0.85"/>
          <path d="M720,400 L40,650" stroke-width="2.2" opacity="0.9"/>
          <path d="M720,400 L20,200" stroke-width="2" opacity="0.8"/>
          <!-- Secondary branches off primary cracks -->
          <path d="M600,260 L480,30" stroke-width="1.2" opacity="0.6"/>
          <path d="M600,260 L310,180" stroke-width="1" opacity="0.55"/>
          <path d="M850,200 L980,10" stroke-width="1.2" opacity="0.6"/>
          <path d="M850,200 L1200,120" stroke-width="1" opacity="0.5"/>
          <path d="M1100,340 L1380,200" stroke-width="1.2" opacity="0.6"/>
          <path d="M1180,560 L1440,480" stroke-width="1" opacity="0.55"/>
          <path d="M1050,720 L1300,850" stroke-width="1.2" opacity="0.6"/>
          <path d="M820,700 L740,900" stroke-width="1" opacity="0.5"/>
          <path d="M600,720 L380,900" stroke-width="1.2" opacity="0.6"/>
          <path d="M440,640 L100,820" stroke-width="1" opacity="0.55"/>
          <path d="M260,500 L0,620" stroke-width="1.2" opacity="0.6"/>
          <path d="M200,330 L0,250" stroke-width="1" opacity="0.5"/>
          <path d="M340,180 L120,40" stroke-width="1.2" opacity="0.6"/>
          <!-- Tertiary micro-cracks -->
          <path d="M520,160 L440,60" stroke-width="0.7" opacity="0.4"/>
          <path d="M470,320 L320,240" stroke-width="0.7" opacity="0.4"/>
          <path d="M900,160 L820,40" stroke-width="0.7" opacity="0.4"/>
          <path d="M1000,280 L1150,180" stroke-width="0.7" opacity="0.4"/>
          <path d="M1260,440 L1400,360" stroke-width="0.7" opacity="0.4"/>
          <path d="M1200,640 L1360,720" stroke-width="0.7" opacity="0.4"/>
          <path d="M940,800 L1060,900" stroke-width="0.7" opacity="0.4"/>
          <path d="M680,820 L600,900" stroke-width="0.7" opacity="0.4"/>
          <path d="M480,780 L300,900" stroke-width="0.7" opacity="0.4"/>
          <path d="M320,620 L140,740" stroke-width="0.7" opacity="0.4"/>
          <path d="M160,440 L20,520" stroke-width="0.7" opacity="0.4"/>
          <path d="M220,260 L60,160" stroke-width="0.7" opacity="0.4"/>
        </g>
        <!-- Impact center glow circle -->
        <circle id="crack-center" cx="720" cy="400" r="28" fill="none" stroke="white" stroke-width="3" opacity="0.9"/>
        <circle cx="720" cy="400" r="12" fill="white" opacity="0.7"/>
        <!-- Shatter chunks near center -->
        <g stroke="white" stroke-width="0.8" fill="rgba(255,255,255,0.04)" opacity="0.7">
          <polygon points="720,400 680,360 700,320 740,340"/>
          <polygon points="720,400 760,370 790,400 760,430"/>
          <polygon points="720,400 690,440 660,420 670,380"/>
          <polygon points="720,400 740,450 710,470 690,440"/>
        </g>
      </g>
    </svg>
  </div>
  <div class="bg-black py-10 mb-8">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-white text-4xl md:text-5xl font-bold mb-4">About Me</h1>
      <div class="h-28 md:h-16">
